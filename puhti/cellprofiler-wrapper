#!/PUHTI_TYKKY_SYR94yI/miniforge/envs/env1/bin/python3
"""
Wrapper for CellProfiler that monkey-patches skimage to restore compatibility
with older CellProfiler code using the deprecated 'selem' keyword argument
(renamed to 'footprint' in scikit-image >= 0.20).

Also patches MeasureObjectIntensityDistribution to handle fields with zero
identified objects (IndexError on empty array), and uses os._exit() instead of
sys.exit() to avoid a JVM SIGSEGV crash in javabridge's atexit cleanup.

Deploy:
    cp puhti/cellprofiler-wrapper \
       /projappl/project_XXXXXXX/cellprofiler-env/_bin/cellprofiler
    chmod +x /projappl/project_XXXXXXX/cellprofiler-env/_bin/cellprofiler
    # Verify LF line endings (CRLF causes "bad interpreter" error):
    file /projappl/project_XXXXXXX/cellprofiler-env/_bin/cellprofiler
"""
import sys
import skimage.morphology

# --- patch erosion ---
_orig_erosion = skimage.morphology.erosion
def _erosion(image, footprint=None, selem=None, **kwargs):
    if selem is not None and footprint is None:
        footprint = selem
    return _orig_erosion(image, footprint=footprint, **kwargs)
skimage.morphology.erosion = _erosion

# --- patch dilation ---
_orig_dilation = skimage.morphology.dilation
def _dilation(image, footprint=None, selem=None, **kwargs):
    if selem is not None and footprint is None:
        footprint = selem
    return _orig_dilation(image, footprint=footprint, **kwargs)
skimage.morphology.dilation = _dilation

# --- patch reconstruction ---
_orig_reconstruction = skimage.morphology.reconstruction
def _reconstruction(seed, mask, method='dilation', footprint=None, selem=None, offset=None):
    if selem is not None and footprint is None:
        footprint = selem
    return _orig_reconstruction(seed, mask, method=method, footprint=footprint, offset=offset)
skimage.morphology.reconstruction = _reconstruction

# --- patch MeasureObjectIntensityDistribution for empty object sets ---
# CellProfiler 4.x crashes with IndexError when a field has zero identified
# objects: `lg[numpy.argsort(...)[:, 0]]` fails on an empty array.
import logging as _logging
def _patch_moid():
    from cellprofiler.modules.measureobjectintensitydistribution import MeasureObjectIntensityDistribution
    _orig_run = MeasureObjectIntensityDistribution.run
    def _run(self, workspace):
        try:
            return _orig_run(self, workspace)
        except IndexError:
            _logging.getLogger(__name__).warning(
                "MeasureObjectIntensityDistribution: IndexError (no objects in image), skipping"
            )
    MeasureObjectIntensityDistribution.run = _run
_patch_moid()

# --- run CellProfiler ---
import os
from cellprofiler.__main__ import main
ret = main()
# Use os._exit() to skip Python/javabridge atexit cleanup, which causes a
# JVM SIGSEGV crash on shutdown (exit 134). All output is already flushed
# by the time main() returns.
os._exit(ret if ret is not None else 0)
