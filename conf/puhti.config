// CSC Puhti configuration for tglow-pipeline
// Tykky integration: conda.enabled=false; beforeScript adds the correct
// Tykky env bin/ to PATH per process (by process name for cpr vs tglow env).
//
// Process -> env mapping (from inspecting processes/):
//   finalize, finalize_and_cellprofiler, cellprofiler -> cpr_conda_env
//   all other processes                               -> tg_conda_env

TGLOW_ENV = '/projappl/project_2018108/tglow-env'
CPR_ENV   = '/projappl/project_2018108/cellprofiler-env'

conda.enabled = false

process {
    executor       = 'slurm'
    clusterOptions = '--account=project_2018108'
    maxRetries     = 2
    errorStrategy  = { task.attempt <= 2 ? 'retry' : 'finish' }
    resourceLimits = [cpus: 40, memory: '370.GB', time: '12.h']

    // Default: tglow environment (Python 3.10) for all processes
    beforeScript = "export PATH=${TGLOW_ENV}/bin:\$PATH"

    // Override for CellProfiler processes -> cellprofiler env (Python 3.9)
    withName: 'finalize|finalize_and_cellprofiler|cellprofiler' {
        beforeScript = "export PATH=${CPR_ENV}/bin:\$PATH"
    }

    // CPU / imaging labels -> Puhti 'small' partition.
    // Note: Nextflow replaces the entire withLabel block from processes.config when
    // the same label is redefined here, so memory and time must be restated explicitly.
    withLabel: tiny_img    { queue = 'small'; memory = 4.GB;                      time = '1h'  }
    withLabel: small_img   { queue = 'small'; memory = { 6.GB * task.attempt };   time = { 1.hour * task.attempt } }
    withLabel: long_img    { queue = 'small'; memory = { 4.GB * task.attempt };   time = '12h' }
    withLabel: normal_img  { queue = 'small'; memory = { 16.GB * task.attempt };  time = { 2.hour * task.attempt } }
    withLabel: tiny        { queue = 'small'; memory = 1.GB;                      time = '1h'  }
    withLabel: small       { queue = 'small'; memory = { 6.GB * task.attempt };   time = { 2.hour * task.attempt } }
    withLabel: normal      { queue = 'small'; memory = { 10.GB * task.attempt };  time = { 2.hour * task.attempt } }
    withLabel: normal_plus { queue = 'small'; memory = { 16.GB * task.attempt };  time = '12h' }
    withLabel: medium      { queue = 'small'; memory = { 32.GB * task.attempt };  time = '12h' }
    withLabel: himem       { queue = 'small'; memory = { 64.GB * task.attempt };  time = '12h' }

    // GPU labels -> Puhti 'gpu' partition with one V100.
    // Memory and time are also restated here for the same reason as above.
    withLabel: gpu_short       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 16.GB * task.attempt }; time = { 1.hour * task.attempt } }
    withLabel: gpu_small       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 8.GB  * task.attempt }; time = { 2.hour * task.attempt } }
    withLabel: gpu_normal      { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 16.GB * task.attempt }; time = { 2.hour * task.attempt } }
    withLabel: gpu_normal_plus { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 24.GB * task.attempt }; time = { 2.hour * task.attempt } }
    withLabel: gpu_medium      { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 32.GB * task.attempt }; time = { 2.hour * task.attempt } }
    withLabel: gpu_himem       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1'; memory = { 64.GB * task.attempt }; time = { 2.hour * task.attempt } }
}

executor {
    name            = 'slurm'
    perJobMemLimit  = true
    poolSize        = 4
    submitRateLimit = '5 sec'
    killBatchSize   = 40
    queueSize       = 40
}
