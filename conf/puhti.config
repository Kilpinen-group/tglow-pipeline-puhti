// CSC Puhti configuration for tglow-pipeline
// Tykky integration: conda.enabled=false; beforeScript adds the correct
// Tykky env bin/ to PATH per process (by process name for cpr vs tglow env).
//
// Process -> env mapping (from inspecting processes/):
//   finalize, finalize_and_cellprofiler, cellprofiler -> cpr_conda_env
//   all other processes                               -> tg_conda_env

TGLOW_ENV = '/projappl/project_2018108/tglow-env'
CPR_ENV   = '/projappl/project_2018108/cellprofiler-env'

conda.enabled = false

process {
    executor       = 'slurm'
    clusterOptions = '--account=project_2018108'
    maxRetries     = 2
    errorStrategy  = { task.attempt <= 2 ? 'retry' : 'finish' }
    resourceLimits = [cpus: 40, memory: '370.GB', time: '12.h']

    // Default: tglow environment (Python 3.10) for all processes
    beforeScript = "export PATH=${TGLOW_ENV}/bin:\$PATH"

    // Override for CellProfiler processes -> cellprofiler env (Python 3.9)
    withName: 'finalize|finalize_and_cellprofiler|cellprofiler' {
        beforeScript = "export PATH=${CPR_ENV}/bin:\$PATH"
    }

    // CPU / imaging labels -> Puhti 'small' partition
    withLabel: tiny_img    { queue = 'small' }
    withLabel: small_img   { queue = 'small' }
    withLabel: long_img    { queue = 'small'; time = '12h' }
    withLabel: normal_img  { queue = 'small' }
    withLabel: tiny        { queue = 'small' }
    withLabel: small       { queue = 'small' }
    withLabel: normal      { queue = 'small' }
    withLabel: normal_plus { queue = 'small' }
    withLabel: medium      { queue = 'small' }
    withLabel: himem       { queue = 'small' }

    // GPU labels -> Puhti 'gpu' partition with one V100
    withLabel: gpu_short       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
    withLabel: gpu_small       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
    withLabel: gpu_normal      { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
    withLabel: gpu_normal_plus { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
    withLabel: gpu_medium      { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
    withLabel: gpu_himem       { queue = 'gpu'; clusterOptions = '--account=project_2018108 --gres=gpu:v100:1' }
}

executor {
    name            = 'slurm'
    perJobMemLimit  = true
    poolSize        = 4
    submitRateLimit = '5 sec'
    killBatchSize   = 40
    queueSize       = 40
}
